# Application Settings
APP_NAME=MedCare Pharma SCM Control Tower
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*

# ------------------------------------------------------------------------------
# 100% FREE DATABASE OPTIONS
# ------------------------------------------------------------------------------
# OPTION 1: Neon.tech (RECOMMENDED - Forever Free 0.5 GB PostgreSQL + Instant SSL)
# Sign up at https://neon.tech/ (No credit card needed) -> Copy connection string:
# DATABASE_URL=postgresql+asyncpg://neondb_owner:npg_xxxx@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# OPTION 2: Supabase Free PostgreSQL
# Sign up at https://supabase.com/ -> Project Settings -> Database -> Connection String (URI):
# DATABASE_URL=postgresql+asyncpg://postgres:YourPass@db.xxxx.supabase.co:5432/postgres?sslmode=require

# OPTION 3: Render Free Managed PostgreSQL (90-Day Free Tier)
# Created automatically if using Render Blueprint (render.yaml)

# OPTION 4: Embedded SQLite (Zero Cost, No External Database Required)
# Automatically used as fallback if DATABASE_URL is left blank!
# DATABASE_URL=sqlite+aiosqlite:///./medcare_scm.db

# ------------------------------------------------------------------------------
# Security Credentials
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=medcare_scm_free_tier_jwt_secret_token_9843217894321
ADMIN_INITIAL_PASSWORD=Admin@12345

# ------------------------------------------------------------------------------
# Free AI & Free Alert Dispatch Services
# ------------------------------------------------------------------------------
# Gemini API Key (100% Free Tier: 15 Requests/min via Google AI Studio)
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Resend Email API Key (Free 3,000 emails/month, 100 emails/day)
# https://resend.com/
RESEND_API_KEY=

# Frontend URL (e.g. your free Vercel or Render domain)
# Example: https://medcare-control-tower.vercel.app
APP_FRONTEND_URL=http://localhost:5173
