# ==============================================================================
# MedCare Pharma Control Tower - Unified Single-Container Full-Stack Dockerfile
# Perfect for Zero-Cost Single Container Free Hosts (Render, Koyeb, Fly.io, Hugging Face)
# ==============================================================================

# 1. Build Frontend React SPA
FROM node:20-alpine AS frontend-builder
WORKDIR /build-frontend
COPY medcare-frontend/package*.json ./
RUN npm ci
COPY medcare-frontend/ ./
RUN npm run build


# 2. Build Python Backend Dependencies
FROM python:3.12-slim AS backend-builder
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir --prefix=/install -r requirements.txt


# 3. Final Lean Full-Stack Image
FROM python:3.12-slim AS runner
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=backend-builder /install /usr/local
COPY backend ./backend
COPY --from=frontend-builder /build-frontend/dist ./medcare-frontend/dist

# Non-root user for enterprise container security
RUN useradd -m -u 1001 appuser && \
    chown -R appuser:appuser /app

USER appuser

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8000/api/health || exit 1

EXPOSE 8000

ENV HOST=0.0.0.0 \
    PORT=8000 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
