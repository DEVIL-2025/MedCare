# ==============================================================================
# MedCare Pharma Control Tower - Production Environment Configuration
# ==============================================================================

# Application Environment
APP_NAME=MedCare Pharma SCM Control Tower
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8000

# CORS Origins (Comma-separated list of allowed frontend URLs, or * for all)
# Example: CORS_ORIGINS=https://medcare.yourdomain.com,https://medcare-frontend.vercel.app
CORS_ORIGINS=*

# ------------------------------------------------------------------------------
# PostgreSQL Database Connection (Production Managed Database)
# ------------------------------------------------------------------------------
# Option A: Full Connection String (Recommended for Neon, Supabase, Render, Railway, AWS RDS)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL=postgresql+asyncpg://postgres:YourSecurePasswordHere@localhost:5432/medcare_scm

# Option B: Individual Parameters (Used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=medcare_scm
DB_USER=postgres
DB_PASSWORD=YourSecurePasswordHere
DB_SCHEMA=public

# ------------------------------------------------------------------------------
# Security & JWT Authentication
# ------------------------------------------------------------------------------
# Generate a strong 64-character secret key using:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace_with_a_super_secure_random_64_character_hex_token_for_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin User Credentials (Created during initial DB seed if not already present)
ADMIN_INITIAL_PASSWORD=Admin@MedCare2026!

# ------------------------------------------------------------------------------
# AI & External Notification Services (Optional)
# ------------------------------------------------------------------------------
# Google Gemini AI API Key for Natural Language SCM Copilot
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Resend API Key for Transaction & Shortage Email Alerts (Free 3000 emails/month)
# Get a free key at: https://resend.com/
RESEND_API_KEY=

# Alternative SMTP Email Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=alerts@medcare-pharma.com

# Frontend Application URL (Used in alert email links)
APP_FRONTEND_URL=https://medcare.yourdomain.com
